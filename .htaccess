Options -Indexes

# Never serve secrets or logs
<FilesMatch "(^config\.local(\.example)?\.php$|^composer\.(json|lock)$|\.(md|sql|log|bak|ini)$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/.*/logs/
RedirectMatch 404 ^/.*/database/
RedirectMatch 404 ^/.*/vendor/

# Installable app
AddType application/manifest+json .webmanifest
<Files "sw.js">
  Header set Service-Worker-Allowed "/"
  Header set Cache-Control "no-cache"
</Files>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(), microphone=()"
</IfModule>
RedirectMatch 404 ^/.*/cron/
RedirectMatch 404 ^/.*/mobile/
RedirectMatch 404 ^/.*/docs/
